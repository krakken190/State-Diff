# Copy to .env.local and fill in. Never commit .env.local.

# Meta Model API (server-only, never exposed to the browser)
MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_VISION_MODEL=muse-spark-1.3
# Optional; leave blank to disable segmentation
META_SEGMENTATION_MODEL=

# Vision provider: "meta" (live), "replay" (recorded real Meta responses, labelled as replay in the UI), "fake" (tests only)
VISION_PROVIDER=meta

# Local storage
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=12
MAX_IMAGES_PER_CHECKPOINT=3
# Max live inference calls per day (cost guard)
INFERENCE_DAILY_LIMIT=60
